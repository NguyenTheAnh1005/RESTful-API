{
  "info": {
    "name": "Lab 2 Monolithic - kịch bản chấm",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3002"
    },
    {
      "key": "username",
      "value": "lab2_demo"
    },
    {
      "key": "password",
      "value": "Lab2_demo_123"
    },
    {
      "key": "pidX",
      "value": "1"
    },
    {
      "key": "pidY",
      "value": "2"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Healthy\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Đăng ký normal score 10",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"fullname\": \"Sinh viên Lab 2\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"username\", \"lab2_\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Created\",()=>pm.response.to.have.status(201));",
              "const u=pm.response.json(); pm.test(\"Defaults\",()=>{pm.expect(u.role.rolename).to.eql(\"normal\");pm.expect(u.membership.score).to.eql(10);pm.expect(u).not.to.have.property(\"password\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "3 Đăng nhập lấy token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Logged in\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"token\",pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "4 Đặt hàng không token bị từ chối",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"items\": [{\"pid\": {{pidX}}, \"qty\": 2}, {\"pid\": {{pidY}}, \"qty\": 5}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Unauthorized\",()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "5 Đặt X x2 và Y x5",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"items\": [{\"pid\": {{pidX}}, \"qty\": 2}, {\"pid\": {{pidY}}, \"qty\": 5}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Created\",()=>pm.response.to.have.status(201));",
              "const o=pm.response.json(); pm.collectionVariables.set(\"orderId\",o.oid);",
              "pm.test(\"Details and shipment\",()=>{pm.expect(o.details).to.have.lengthOf(2);pm.expect(o.shipments).to.have.lengthOf(1);pm.expect(Math.abs(Date.now()-Date.parse(o.createat))).to.be.below(60000);});"
            ]
          }
        }
      ]
    },
    {
      "name": "6 Xem đơn và chi tiết",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/orders/{{orderId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"OK\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "7 Xem shipment",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/orders/{{orderId}}/shipments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"OK\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}